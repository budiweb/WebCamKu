<Window x:Class="WebCamKu.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebCamKu" Height="520" Width="760"
        MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Border Background="#111827" CornerRadius="12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="WebCamKu" Foreground="White" FontSize="32"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Windows client is ready"
                           Foreground="#D1D5DB" FontSize="16" Margin="0,12,0,0" />
                <TextBlock Text="Streaming will be added in a later milestone."
                           Foreground="#9CA3AF" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

