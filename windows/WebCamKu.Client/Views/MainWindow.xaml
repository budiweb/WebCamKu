<Window x:Class="WebCamKu.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebCamKu" Height="560" Width="760" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#111827" CornerRadius="12" Padding="12">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" />
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#B0000000" Padding="10" CornerRadius="6">
                    <TextBlock x:Name="StatisticsText" Text="Frames: 0 | FPS: 0 | 0 Mbps | Dropped: 0 | Errors: 0"
                               Foreground="White" FontSize="14" />
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ConnectionModeComboBox" Grid.Column="1" SelectedIndex="0" Padding="6"
                      SelectionChanged="ConnectionModeComboBox_SelectionChanged">
                <ComboBoxItem Content="Wi-Fi" />
                <ComboBoxItem Content="USB (ADB)" />
            </ComboBox>
            <TextBlock Grid.Column="2" Text="Phone IP" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox x:Name="HostTextBox" Grid.Column="3" Text="192.168.1.20" Padding="8" />
            <TextBlock Grid.Column="4" Text="Port" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox x:Name="PortTextBox" Grid.Column="5" Text="4747" Padding="8" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ConnectButton" Content="Connect" Width="110" Padding="8" Click="ConnectButton_Click" />
            <Button x:Name="DisconnectButton" Content="Disconnect" Width="110" Padding="8" Margin="10,0,0,0"
                    IsEnabled="False" Click="DisconnectButton_Click" />
            <TextBlock x:Name="StatusText" Text="Disconnected" VerticalAlignment="Center" Margin="18,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Start Virtual Camera" Width="150" Padding="8" Click="StartVirtualCameraButton_Click" />
            <Button Content="Stop Virtual Camera" Width="150" Padding="8" Margin="10,0,0,0"
                    Click="StopVirtualCameraButton_Click" />
            <TextBlock Text="Shared frames continue even when preview repaint is delayed."
                       VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#475569" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="SwitchCameraButton" Content="Switch Camera" Width="120" Padding="8"
                    IsEnabled="False" Click="SwitchCameraButton_Click" />
            <ToggleButton x:Name="TorchButton" Content="Torch" Width="90" Padding="8" Margin="10,0,0,0"
                          IsEnabled="False" Click="TorchButton_Click" />
            <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="18,0,8,0" />
            <Slider x:Name="ZoomSlider" Width="180" Minimum="1" Maximum="8" Value="1"
                    TickFrequency="0.5" IsSnapToTickEnabled="True" IsEnabled="False"
                    PreviewMouseLeftButtonUp="ZoomSlider_MouseLeftButtonUp" />
            <TextBlock x:Name="ZoomText" Text="1.0x" Width="45" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
